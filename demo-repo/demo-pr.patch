@@ -0,0 +1,6 @@
+export function normalizeScore(score: number, max: number): number {
+  if (!Number.isFinite(score) || !Number.isFinite(max) || max <= 0) {
+    throw new RangeError("score and max must be finite, and max must be positive");
+  }
+  return Math.min(Math.max(score / max, 0), 1);
+}
