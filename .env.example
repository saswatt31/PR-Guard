# --- Core ---
APP_ENV=development
DATABASE_URL=sqlite:///./data/prguard.db
DEMO_MODE=false
ALLOW_FORK_PRS=false

# --- GitHub App ---
# Create an app at https://github.com/settings/apps and point its webhook at
# your tunnel URL + /webhooks/github
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./secrets/prguard-app.pem
GITHUB_WEBHOOK_SECRET=change-me
# Used only by scripts/capture_demo_run.py against the public demo repo.
GITHUB_TOKEN=

# --- LLM provider (fake | groq | anthropic) ---
LLM_PROVIDER=fake
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
MAX_LLM_CALLS=24
MAX_TOTAL_TOKENS=120000
MAX_COST_USD=0.75

# --- Sandbox ---
# docker is the only security boundary. local is for the demo machine only.
SANDBOX_MODE=docker
SANDBOX_IMAGE=prguard-sandbox:node20
SANDBOX_TIMEOUT_SECONDS=180
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=256
SANDBOX_INSTALL_NETWORK=true

# --- Dashboard ---
CORS_ORIGINS=http://localhost:3000
# Used to link to the dashboard from PR comments.
DASHBOARD_BASE_URL=http://localhost:3000
